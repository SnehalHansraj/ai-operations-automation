# --- Database ---
# Local/no-Docker default (zero setup):
DATABASE_URL=sqlite:///./data/app.db
# Uncomment for docker-compose (Postgres):
# DATABASE_URL=postgresql://ops_user:ops_pass@db:5432/ops_automation

# --- LLM Provider ---
# Options: mock | openai | anthropic
# "mock" needs NO API key and lets the whole project run out of the box.
LLM_PROVIDER=mock
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Notifications (optional) ---
SLACK_WEBHOOK_URL=
NOTIFY_EMAIL=ops-team@example.com
